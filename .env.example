# ---- 银枢·AI银行副驾 环境变量 ----
# 复制为 .env 后填写。所有密钥只留在后端，绝不会出现在前端代码里。
# 不填也能跑：系统会自动降级到内置的"本地意图引擎"（离线演示模式），
# 适合比赛现场无网络/无 Key 的兜底演示。

# 服务端口
PORT=8787

# ---- 大模型（OpenAI 兼容接口）----
# 留空 = 使用本地意图引擎（离线演示模式）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 例如对接 DeepSeek：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# 例如对接本地 Ollama：
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
